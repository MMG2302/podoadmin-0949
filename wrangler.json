{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sandbox-website-template",
  "compatibility_date": "2025-06-17",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./src/worker.ts",
  "observability": { "enabled": true },
  "upload_source_maps": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "triggers": {
    "crons": ["0 * * * *", "0 4 * * *", "0 5 * * *", "0 6 * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sandbox-website-template",
      "database_id": "e49f965d-a9a7-4c0d-83e5-1172b032e298",
      "migrations_dir": "src/api/migrations"
    }
  ],
  "r2_buckets": [
    {
      "bucket_name": "sandbox-website-template",
      "binding": "BUCKET"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "RATE_LIMIT_KV",
      "id": "local-rate-limit-kv-dev"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "NOTIFICATIONS_QUEUE",
        "queue": "podoadmin-notifications"
      }
    ],
    "consumers": [
      {
        "queue": "podoadmin-notifications",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 3
      }
    ]
  },
  "env": {
    "production": {
      "name": "podoraa",
      "preview_urls": false,
      "vars": {
        "NODE_ENV": "production",
        "APP_BASE_URL": "https://podoraa.podoraa.workers.dev",
        "ALLOWED_ORIGINS": "https://podoraa.podoraa.workers.dev",
        "OFFICIAL_APP_DOMAIN": "https://podoraa.podoraa.workers.dev",
        "RESEND_FROM_EMAIL": "onboarding@resend.dev",
        "SUPPORT_EMAIL": "soporte@podoraa.com",
        "CAPTCHA_PROVIDER": "turnstile",
        "CAPTCHA_SITE_KEY": "0x4AAAAAAEHn5H2j_5bDioYI",
        "STRIPE_PUBLISHABLE_KEY": "pk_test_51QKiLGDQ5jzhgiLFG9XD5X96JdVVCzdvqZXS9Hfgy65ZrvDfnXkLbAYJbUwEwkwKhmwyUSypttThMMcIVOSUn42800WRynaW0g",
        "STRIPE_PRICE_INDEPENDENT_MONTHLY": "price_1U1FNqDQ5jzhgiLFYfOkFXGS",
        "STRIPE_PRICE_INDEPENDENT_PREMIUM_MONTHLY": "price_1U1FHGDQ5jzhgiLF1CWFdEjJ",
        "STRIPE_PRICE_CLINIC_MONTHLY_STANDARD": "price_1U1FHaDQ5jzhgiLFAGi6rUmD",
        "STRIPE_PRICE_CLINIC_PREMIUM_MONTHLY": "price_1U1FHtDQ5jzhgiLFmIcm3J8f",
        "STRIPE_PRICE_EXTRA_PODIATRIST_MONTHLY": "price_1U1FIEDQ5jzhgiLFEUEN8Ixa",
        "RATE_LIMIT_ANON_READ_PER_MIN": "180",
        "RATE_LIMIT_ANON_WRITE_PER_MIN": "90",
        "RATE_LIMIT_AUTH_READ_PER_MIN": "600",
        "RATE_LIMIT_AUTH_WRITE_PER_MIN": "300",
        "RATE_LIMIT_BURST_PER_10S": "80",
        "RATE_LIMIT_TENANT_READ_PER_MIN": "2000",
        "RATE_LIMIT_TENANT_WRITE_PER_MIN": "800"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "podoraa-prod",
          "database_id": "33f324fd-8695-453e-b739-e33f1ddc2c97",
          "migrations_dir": "src/api/migrations"
        }
      ],
      "r2_buckets": [
        {
          "bucket_name": "podoraa-prod",
          "binding": "BUCKET"
        }
      ],
      "kv_namespaces": [
        {
          "binding": "RATE_LIMIT_KV",
          "id": "d7d5d1c4907f4eeba27d83179127f795"
        }
      ],
      "queues": {
        "producers": [
          {
            "binding": "NOTIFICATIONS_QUEUE",
            "queue": "podoraa-notifications-prod"
          }
        ],
        "consumers": [
          {
            "queue": "podoraa-notifications-prod",
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            "max_retries": 3
          }
        ]
      }
    }
  }
}
